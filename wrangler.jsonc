{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartbeavers",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The React SPA. Unknown paths fall back to index.html for client-side routing;
    // /api/* and /hook/* always go to the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/hook/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    // Production values. Local dev overrides these from .dev.vars.
    // The secret key is set with `wrangler secret put SUPABASE_SECRET_KEY`, never here.
    "SUPABASE_URL": "https://zpxkocfjbeqjtofsmqti.supabase.co"
  },
  "routes": [{ "pattern": "smartbeavers.work", "custom_domain": true }]
}
