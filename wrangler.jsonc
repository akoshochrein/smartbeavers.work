{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartbeavers",
  // TanStack Start's server entry: serves the page shell, the built assets and the server
  // routes in src/routes/api and src/routes/hook.
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Production values. Local dev overrides these from .dev.vars.
    // The secret key is set with `wrangler secret put SUPABASE_SECRET_KEY`, never here.
    "SUPABASE_URL": "https://zpxkocfjbeqjtofsmqti.supabase.co"
  },
  "routes": [{ "pattern": "smartbeavers.work", "custom_domain": true }]
}
