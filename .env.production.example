# Copy to .env.production. Used by `pnpm build` and `pnpm deploy`. Not committed.
# Everything here ends up in browser code, so public values only: the publishable key is meant
# to be public, and access is enforced by row level security in the database.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Who runs this deployment. Shown on the contact page, the privacy policy and the terms.
# Leave a value empty to hide it. Fill in at least name and email before going public.
VITE_OPERATOR_NAME=""
VITE_OPERATOR_EMAIL=""
VITE_OPERATOR_COUNTRY=""
VITE_OPERATOR_AUTHORITY=""
VITE_OPERATOR_ADDRESS=""
VITE_OPERATOR_GITHUB=""
VITE_OPERATOR_LINKEDIN=""
